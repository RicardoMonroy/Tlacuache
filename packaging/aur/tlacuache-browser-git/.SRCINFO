pkgbase = tlacuache-browser-git
	pkgdesc = Gestor de archivos con columnas Miller, doble panel y una terminal integrada en cada panel (GTK4)
	pkgver = 0.2.0
	pkgrel = 1
	url = https://github.com/rmonroy/TlacuacheBrowser
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = cargo
	makedepends = git
	depends = gtk4
	depends = libadwaita
	depends = vte4
	depends = gtksourceview5
	depends = poppler-glib
	depends = gdk-pixbuf2
	depends = glib2
	depends = cairo
	depends = pango
	depends = gcc-libs
	depends = glibc
	optdepends = gst-plugins-good: reproducir video y audio en la vista previa
	optdepends = gst-libav: más formatos de video y audio
	optdepends = ttf-jetbrains-mono: fuente monoespaciada de los temas
	provides = tlacuache-browser
	conflicts = tlacuache-browser
	options = !debug
	source = tlacuache-browser::git+https://github.com/rmonroy/TlacuacheBrowser.git
	sha256sums = SKIP

pkgname = tlacuache-browser-git
